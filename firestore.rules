rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything a user saves lives under users/{uid}: profile, saved stories,
    // saved analyses and game scores. Only that user can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
